# Copy to .env (production) or .env.local (development).
POSTGRES_PASSWORD=
AUTH_SECRET=                # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=               # comma-separated, always admins
RUNTIME_TOKEN=              # shared with agent.rcsl.online (STUDIO_RUNTIME_TOKEN there)
SECRETS_KEY=                # 32 random bytes, base64; losing it makes stored MCP credentials unreadable
RCSL_API=http://192.168.100.18:8887
RCSL_AUTHORIZATION=         # Authorization header value for the RCSL data API
# Development only
# DATABASE_URL=postgres://studio:studio@127.0.0.1:54329/agent_studio
# DEV_LOGIN=1
