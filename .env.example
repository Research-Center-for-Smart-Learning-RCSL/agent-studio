# Copy to .env (production) or .env.local (development).
POSTGRES_PASSWORD=
AUTH_SECRET=                # node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=               # comma-separated, always admins
RUNTIME_TOKEN=              # shared with agent.rcsl.online (STUDIO_RUNTIME_TOKEN there)
SECRETS_KEY=                # 32 random bytes, base64; losing it makes stored MCP credentials unreadable
RCSL_API=http://192.168.100.18:8887
# Compose network subnet, pinned (docker-compose.yml). Never leave it to
# Docker: its next pick on lab-100-18 covers the VPN clients and cuts the host
# off. scripts/preflight.sh checks it against every range in use.
STUDIO_SUBNET=172.16.251.0/24
# Host address the app port binds to (Nginx Proxy Manager proxies to it).
STUDIO_BIND=192.168.100.18
RCSL_AUTHORIZATION=         # Authorization header value for the RCSL data API
# Logs (docs/logs-integration.md). Both set shows the Logs item in the sidebar.
LOGS_API=http://192.168.100.18:8031/api
LOGS_SERVICE_TOKEN=         # same value as STUDIO_SERVICE_TOKEN in the Logs stack's .env
# Optional: enable uploads using OpenAI-verified RCSL credential fingerprints.
# STUDIO_FILE_KEY_FINGERPRINTS='{"proj_example":["sha256-fingerprint"]}'
# Per-project override for keys with Files and Vector Stores access.
# STUDIO_FILE_UPLOAD_KEYS='{"proj_example":"replace-with-project-key"}'

# Development only
# DATABASE_URL=postgres://studio:studio@127.0.0.1:54329/agent_studio
# DEV_LOGIN=1
